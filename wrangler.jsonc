// Cloudflare Worker, der die fertige Seite aus dist/ ausliefert.
// Vor jede Anfrage schaltet worker/index.js die Anmeldeseite (Secret PASSWORT).
// Erreichbar unter https://lieblingsrezepte.<account>.workers.dev
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lieblingsrezepte",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Sonst würden vorhandene Dateien ohne Passwort ausgeliefert.
    "run_worker_first": true
  }
  // Eigene Domain später (Domain muss bei Cloudflare verwaltet werden):
  // "routes": [{ "pattern": "rezepte.example.de", "custom_domain": true }]
}
