// Cloudflare Worker mit der Astro-Seite. Jede Anfrage wird im Worker gerendert und liest aus D1.
// Den Einstieg baut @astrojs/cloudflare. Angemeldet wird über Cloudflare Access (src/lib/anmeldung.ts).
// Erreichbar unter https://lieblingsrezepte.<account>.workers.dev
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lieblingsrezepte",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-28",
  // Cloudflare Access: Team-Name (<team>.cloudflareaccess.com) und „Application Audience (AUD) Tag“
  // der Access-App. Beides steht im Dashboard unter Zero Trust → Access → Applications.
  "vars": {
    "ACCESS_TEAM": "kochfreunde",
    "ACCESS_AUD": "811abc37a5c8d1d6fac0c1d88abe7f626b06722223dc3c051e399c8c427a0f43"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  // Datenbank mit allen Rezeptbüchern. Lokal (--local) liegt sie in .wrangler/.
  // Angelegt in Westeuropa (wrangler d1 create rezepte --location weur).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rezepte",
      "database_id": "17ebee89-6191-4d86-84b5-271936c1213b",
      "migrations_dir": "migrations"
    }
  ],
  // Fotos der Rezepte. Angelegt in Westeuropa (wrangler r2 bucket create rezepte-bilder --location weur).
  "r2_buckets": [
    {
      "binding": "BILDER",
      "bucket_name": "rezepte-bilder"
    }
  ]
  // Eigene Domain später (Domain muss bei Cloudflare verwaltet werden):
  // "routes": [{ "pattern": "rezepte.example.de", "custom_domain": true }]
}
