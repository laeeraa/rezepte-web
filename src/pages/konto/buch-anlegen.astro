---
import Layout from '../../layouts/Layout.astro';
import { legeBuchAn, pruefeBuch, vorschlagSlug } from '../../lib/buch-anlegen';

const nutzer = Astro.locals.nutzer!;
let name = `${nutzer.name}s Rezepte`;
let slug = vorschlagSlug(nutzer.name);
let fehler: string[] = [];

if (Astro.request.method === 'POST') {
  const formular = await Astro.request.formData();
  name = String(formular.get('name') ?? '').trim().replace(/\s+/g, ' ').slice(0, 80);
  slug = String(formular.get('slug') ?? '').trim().toLowerCase();
  fehler = await pruefeBuch(name, slug);
  if (!fehler.length) {
    await legeBuchAn(nutzer, name, slug);
    return Astro.redirect(`/${slug}`, 303);
  }
  Astro.response.status = 422;
}
---

<Layout titel="Rezeptbuch anlegen" schmal>
  <h1>Eigenes Rezeptbuch anlegen</h1>
  <p class="leise">
    Dein Buch startet mit den Kategorien Süßes, Brot &amp; Brötchen, Herzhaftes und Getränke und passenden Tags
    (Art, Ernährung, Mahlzeit, Küche, …). Später lässt sich das anpassen.
  </p>

  <form method="post" class="formular">
    {fehler.length > 0 && (
      <ul class="fehler" role="alert">{fehler.map((f) => <li>{f}</li>)}</ul>
    )}
    <label class="feld">
      <span class="beschriftung">Name des Buchs</span>
      <input name="name" value={name} required maxlength="80" />
    </label>
    <label class="feld">
      <span class="beschriftung">Adresse</span>
      <span class="adresse"><span class="leise">{Astro.url.host}/</span><input name="slug" value={slug} required pattern="[a-z0-9]+(-[a-z0-9]+)*" minlength="2" maxlength="30" /></span>
      <span class="leise klein">Kleinbuchstaben, Ziffern und Bindestriche. Lässt sich später nicht mehr ändern.</span>
    </label>
    <div><button type="submit" class="haupt">Anlegen</button></div>
  </form>
</Layout>

<style>
  .formular { display: grid; gap: 1.1rem; margin-top: 1.5rem; }
  .feld { display: grid; gap: 0.35rem; }
  .beschriftung { font-weight: 600; }
  input { font: inherit; padding: 0.6rem 0.75rem; border: 1px solid var(--linie); border-radius: 8px; background: var(--karte); color: var(--text); width: 100%; }
  .adresse { display: flex; align-items: center; gap: 0.25rem; }
  .klein { font-size: 0.85rem; }
  .fehler { color: var(--fehler); margin: 0; padding-left: 1.2rem; }
  .haupt { font: inherit; font-weight: 600; padding: 0.65rem 1.5rem; border: 0; border-radius: 999px; background: var(--akzent); color: var(--papier); cursor: pointer; }
</style>
