---
import Layout from '../layouts/Layout.astro';
import { ABMELDEN_URL } from '../lib/anmeldung';

// Eingeladene Personen haben hier nichts zu suchen.
if (Astro.locals.nutzer) return Astro.redirect('/');
Astro.response.status = 403;
---

<Layout titel="Kein Zugang" schmal>
  <h1>Noch kein Zugang</h1>
  <p>
    Du bist als <strong>{Astro.locals.email}</strong> angemeldet, aber noch nicht eingeladen.
    Frag jemanden, der schon dabei ist, nach einem Einladungslink.
  </p>
  <p class="leise">
    Schon eingeladen, aber mit einer anderen Adresse? <a href={ABMELDEN_URL}>Abmelden</a> und mit der richtigen anmelden.
  </p>
</Layout>
