---
import Layout from '../layouts/Layout.astro';
import { ladeBuecher } from '../lib/db';
import { SEITENNAME } from '../lib/anzeige';
import Neuigkeiten from '../components/Neuigkeiten.astro';

const buecher = await ladeBuecher();
const { nutzer } = Astro.locals;
---

<Layout titel="Alle Rezeptbücher">
  <h1>{SEITENNAME}</h1>
  <p class="leise">Die Rezeptbücher von uns allen.</p>
  <ul class="buecher">
    {buecher.map((b) => (
      <li class={`thema-${b.farbe}`}>
        <a href={`/${b.slug}`}>
          <span class="name">{b.name}</span>
          {b.besitzer && <span class="von">von {b.besitzer}</span>}
          <span class="anzahl">{b.anzahl} {b.anzahl === 1 ? 'Rezept' : 'Rezepte'}</span>
        </a>
      </li>
    ))}
  </ul>
  {nutzer && nutzer.buecher.length === 0 && (
    <p class="eigenes">Noch kein eigenes Rezeptbuch? <a href="/konto/buch-anlegen">Jetzt anlegen</a></p>
  )}
  <Neuigkeiten />
</Layout>

<style>
  .buecher {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .buecher a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem;
    background: var(--karte);
    border-radius: var(--radius);
    border-top: 5px solid var(--akzent);
    background: linear-gradient(var(--kopf), var(--karte) 4.5rem);
    box-shadow: var(--schatten);
    color: var(--text);
    text-decoration: none;
  }
  .buecher a:hover .name { color: var(--akzent); }
  .name { font-family: var(--serif); font-size: 1.5rem; font-weight: 600; line-height: 1.2; }
  .anzahl { color: var(--leise); font-size: 0.9rem; }
  .von { font-size: 0.95rem; }
  .eigenes { margin-top: 2rem; }
</style>
