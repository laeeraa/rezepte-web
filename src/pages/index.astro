---
import Layout from '../layouts/Layout.astro';
import { getRezepte, artLabel } from '../lib/rezepte';
import { GRUPPEN } from '../lib/tags';
import { BEREICHE } from '../vault.mjs';

const rezepte = await getRezepte();
const artReihenfolge = Object.keys(GRUPPEN.art.werte);
const bereiche = BEREICHE.map((b) => {
  const eigene = rezepte.filter((r) => r.bereich.slug === b.slug);
  const arten = artReihenfolge
    .filter((a) => eigene.some((r) => r.art.includes(a)))
    .map((a) => ({ text: artLabel(a), href: `/${b.slug}#art-${a}` }));
  return { ...b, anzahl: eigene.length, arten };
});

// Feste Auswahl für die Chips unter dem Suchfeld.
const schnellzugriff = [
  { href: '/rezepte', text: 'Alle Rezepte' },
  { href: '/rezepte?f=sauerteig', text: 'Sauerteig' },
  { href: '/brot-broetchen#art-brot', text: 'Brot' },
  { href: '/brot-broetchen#art-broetchen', text: 'Brötchen' },
  { href: '/rezepte?f=ernaehrung/vegan', text: 'Vegan' },
  { href: '/rezepte?f=grundrezept', text: 'Grundrezepte' },
  { href: '/rezepte?f=aufwand/schnell', text: 'Schnell' },
];
---

<Layout>
  <h1 class="unsichtbar">Lara's Lieblingsrezepte</h1>

  <form class="suche" action="/rezepte" method="get">
    <input type="search" name="q" placeholder="Rezept oder Zutat suchen …" aria-label="Rezepte durchsuchen" />
  </form>

  <ul class="chips schnell">
    {schnellzugriff.map((s) => <li><a class="chip" href={s.href}>{s.text}</a></li>)}
  </ul>

  <ul class="bereiche">
    {bereiche.map((b) => (
      <li class={`kachel b-${b.slug}`}>
        <a class="name" href={`/${b.slug}`}>{b.ordner}</a>
        <span class="anzahl">{b.anzahl} {b.anzahl === 1 ? 'Rezept' : 'Rezepte'}</span>
        {b.arten.length > 0 && (
          <ul class="arten">
            {b.arten.map((a) => <li><a href={a.href}>{a.text}</a></li>)}
          </ul>
        )}
      </li>
    ))}
    <li class="kachel wissen">
      <a class="name" href="/wissen">Wissen</a>
      <span class="beschreibung">Gewürze, Umrechnungen und mehr zum Nachschlagen</span>
    </li>
  </ul>
</Layout>

<style>
  .suche input {
    width: 100%;
    font: inherit;
    font-size: 1.1rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--linie);
    border-radius: var(--radius);
    background: var(--karte);
    color: var(--text);
  }
  .suche input:focus { outline: 2px solid var(--akzent); outline-offset: 1px; }
  .schnell { margin: 0.9rem 0 2rem; }

  .bereiche {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .kachel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem 1.25rem 1.1rem;
    background: var(--karte);
    border-radius: var(--radius);
    border-top: 5px solid var(--farbe, var(--leise));
    box-shadow: var(--schatten);
  }
  /* Die ganze Kachel ist klickbar, die Arten darin bleiben eigene Links. */
  .name {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .name::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .kachel:hover .name { color: var(--farbe, var(--akzent)); }
  .anzahl { color: var(--farbe); font-weight: 600; font-size: 0.9rem; }
  .beschreibung { color: var(--leise); font-size: 0.9rem; }
  .arten { list-style: none; margin: 0.2rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; }
  .arten a {
    position: relative;
    z-index: 1;
    color: var(--leise);
    font-size: 0.9rem;
    text-decoration: underline;
    text-decoration-color: var(--linie);
    text-underline-offset: 3px;
  }
  .arten a:hover { color: var(--farbe); text-decoration-color: currentColor; }
</style>
