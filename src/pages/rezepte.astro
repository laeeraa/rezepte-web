---
import Layout from '../layouts/Layout.astro';
import RezeptListe from '../components/RezeptListe.astro';
import { getRezepte } from '../lib/rezepte';

const rezepte = await getRezepte();
---

<Layout titel="Alle Rezepte">
  <h1>Alle Rezepte</h1>
  <RezeptListe rezepte={rezepte} mitBereich />
</Layout>
