---
import Layout from '../../layouts/Layout.astro';
import RezeptListe from '../../components/RezeptListe.astro';
import { ladeBuch, ladeRezepte } from '../../lib/db';
import { darfBearbeiten } from '../../lib/nutzer';

const kontext = await ladeBuch(Astro.params.buch!);
const kategorie = kontext?.kategorien.find((k) => k.slug === Astro.params.kategorie);
if (!kontext || !kategorie) return new Response(null, { status: 404 });

const rezepte = (await ladeRezepte(kontext)).filter((r) => r.kategorie.id === kategorie.id);
---

<Layout titel={kategorie.name} klasse={`f-${kategorie.farbe}`} kontext={kontext}>
  <div class="kopf">
    <h1 class="titel">{kategorie.name}</h1>
    {darfBearbeiten(Astro.locals.nutzer, kontext.buch.id) && (
      <a class="neu" href={`/${kontext.buch.slug}/neu?kategorie=${kategorie.slug}`}>+ Rezept hinzufügen</a>
    )}
  </div>
  <RezeptListe kontext={kontext} rezepte={rezepte} gliederung="tag" />
</Layout>

<style>
  .kopf { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0 1rem; }
  .titel { border-bottom: 3px solid var(--farbe); display: inline-block; padding-bottom: 0.1em; }
  .neu { font-size: 0.9rem; color: var(--farbe); }
</style>
