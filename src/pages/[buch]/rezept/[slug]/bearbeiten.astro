---
import Layout from '../../../../layouts/Layout.astro';
import RezeptFormular from '../../../../components/RezeptFormular.astro';
import { ladeBuch, ladeRezeptRoh } from '../../../../lib/db';
import { eingabeAus, eingabeAusFormular, loescheRezept, speichereRezept } from '../../../../lib/rezept-speichern';

const kontext = await ladeBuch(Astro.params.buch!);
const rezept = kontext && (await ladeRezeptRoh(kontext, Astro.params.slug!));
if (!kontext || !rezept) return new Response(null, { status: 404 });
const basis = `/${kontext.buch.slug}`;

let werte = eingabeAus(rezept);
let fehler: string[] = [];

if (Astro.request.method === 'POST') {
  const formular = await Astro.request.formData();
  if (formular.get('aktion') === 'loeschen') {
    await loescheRezept(kontext, rezept);
    return Astro.redirect(basis, 303);
  }
  werte = eingabeAusFormular(formular);
  const ergebnis = await speichereRezept(kontext, werte, rezept);
  if (ergebnis.ok) return Astro.redirect(`${basis}/rezept/${ergebnis.slug}`, 303);
  fehler = ergebnis.fehler;
  Astro.response.status = 422;
}
---

<Layout titel={`${rezept.titel} bearbeiten`} schmal kontext={kontext}>
  <h1>{rezept.titel} <span class="leise">bearbeiten</span></h1>
  <RezeptFormular kontext={kontext} werte={werte} fehler={fehler} zurueck={`${basis}/rezept/${rezept.slug}`} loeschbar />
</Layout>

<style>
  h1 .leise { font-size: 0.6em; font-weight: 400; }
</style>
