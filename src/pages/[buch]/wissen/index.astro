---
import Layout from '../../../layouts/Layout.astro';
import { ladeBuch, ladeSeiten } from '../../../lib/db';

const kontext = await ladeBuch(Astro.params.buch!);
if (!kontext) return new Response(null, { status: 404 });
const seiten = await ladeSeiten(kontext);
---

<Layout titel="Wissen" schmal kontext={kontext}>
  <h1>Wissen</h1>
  <p class="leise">Zum Nachschlagen: alles, was kein Rezept ist.</p>
  {seiten.length === 0 && <p>Hier gibt es noch nichts.</p>}
  <ul class="seiten">
    {seiten.map((s) => <li><a href={`/${kontext.buch.slug}/wissen/${s.slug}`}>{s.titel}</a></li>)}
  </ul>
</Layout>

<style>
  .seiten { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .seiten a {
    display: block;
    padding: 0.9rem 1rem;
    background: var(--karte);
    border-radius: var(--radius);
    box-shadow: var(--schatten);
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
</style>
