---
import '../styles/global.css';
import type { BuchKontext } from '../lib/db';
import { SEITENNAME } from '../lib/anzeige';
import { darfBearbeiten } from '../lib/nutzer';
import { zaehleHinweise } from '../lib/erfahrungen';

interface Props {
  titel?: string;
  schmal?: boolean;
  klasse?: string;
  /** Fehlt auf Seiten außerhalb eines Buchs (Übersicht aller Bücher). */
  kontext?: BuchKontext;
}

const { titel, schmal = false, klasse = '', kontext } = Astro.props;
const { nutzer } = Astro.locals;
const darf = !!kontext && darfBearbeiten(nutzer, kontext.buch.id);
// Neue Einträge anderer zu eigenen Rezepten; die Liste steht im Konto.
const hinweise = nutzer ? await zaehleHinweise(nutzer) : 0;
const NAME = kontext?.buch.name ?? SEITENNAME;
const start = kontext ? `/${kontext.buch.slug}` : '/';
const pfad = Astro.url.pathname.replace(/\/$/, '') || '/';
const anmelden = `/anmelden?zurueck=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
const links = kontext
  ? [
      ...kontext.kategorien.map((k) => ({ href: `${start}/${k.slug}`, text: k.name })),
      { href: `${start}/rezepte`, text: 'Alle Rezepte' },
      { href: `${start}/wissen`, text: 'Wissen' },
      ...(darf ? [{ href: `/bearbeiten${start}/neu`, text: '+ Neues Rezept' }] : []),
    ]
  : [];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{titel ? `${titel} · ${NAME}` : NAME}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🥄</text></svg>" />
  </head>
  <body class:list={[klasse, kontext && `thema-${kontext.buch.farbe}`]}>
    <header class="kopf">
      <div class="kopf-innen">
        <a class="marke" href={start}>{NAME}</a>
        {nutzer
          ? (
            <a class="konto" href={hinweise ? '/konto#neu' : '/konto'} aria-current={pfad.startsWith('/konto') ? 'page' : undefined}>
              {nutzer.name}
              {hinweise > 0 && <span class="hinweis-zahl" aria-label={`${hinweise} neue Einträge zu deinen Rezepten`}>{hinweise}</span>}
            </a>
          )
          : <a class="konto" href={anmelden}>Anmelden</a>}
        {links.length > 0 && (
          <nav class="nav" aria-label="Bereiche">
            {links.map((l) => (
              <a href={l.href} aria-current={pfad === l.href || pfad.startsWith(l.href + '/') ? 'page' : undefined}>{l.text}</a>
            ))}
          </nav>
        )}
      </div>
    </header>
    <main class:list={['inhalt', { schmal }]}>
      <slot />
    </main>
    <footer class="fuss">
      {kontext ? <>{NAME} · <a href="/">Alle Rezeptbücher</a></> : NAME}
      {nutzer && <><br />Angemeldet als {nutzer.name} · <a href="/konto">Konto</a> · <a href="/abmelden">Abmelden</a></>}
    </footer>
  </body>
</html>
